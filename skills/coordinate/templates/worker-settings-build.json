{
  "//": "Generous-tooling overlay for BUILD workers (exhibit/deck/data builds that run scripts and read the repo broadly). Same guard denies as the code overlay; adds script runs and scoped reads/writes. Replace <ABS-PATH-TO-REPO> and <SCRATCH-DIR> with your repo's absolute paths (double-backslash escaped on Windows). Writes stay confined to the worker's one namespace — that is an ownership rule, not a permission nicety.",
  "permissions": {
    "deny": [
      "Edit(**/.claude/settings*.json)",
      "Write(**/.claude/settings*.json)",
      "Edit(**/.claude/hooks/**)",
      "Write(**/.claude/hooks/**)",
      "Edit(**/.githooks/**)",
      "Write(**/.githooks/**)",
      "Edit(**/.gitignore)",
      "Write(**/.gitignore)",
      "Edit(**/worker-settings*.json)",
      "Write(**/worker-settings*.json)",
      "Bash(git config*)",
      "Bash(git push*)",
      "Bash(gh pr merge*)",
      "Bash(gh workflow*)",
      "Bash(gh repo edit*)",
      "Bash(git branch -D*)",
      "Bash(python -c*)",
      "Bash(node -e*)",
      "PowerShell(python -c*)",
      "PowerShell(node -e*)",
      "PowerShell(git push*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git rev-parse*)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(python *)",
      "Bash(py *)",
      "Bash(pip install*)",
      "Bash(pip list*)",
      "Bash(node *)",
      "Bash(npm run*)",
      "Bash(npm test*)",
      "Bash(npm install*)",
      "Bash(npx *)",
      "Bash(ls*)",
      "PowerShell(python *)",
      "PowerShell(pip install*)",
      "PowerShell(node *)",
      "PowerShell(npm run*)",
      "Read(<ABS-PATH-TO-REPO>/**)",
      "Write(<ABS-PATH-TO-REPO>/<SCRATCH-DIR>/**)",
      "Edit(<ABS-PATH-TO-REPO>/<SCRATCH-DIR>/**)"
    ]
  }
}
