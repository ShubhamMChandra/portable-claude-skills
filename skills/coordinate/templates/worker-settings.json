{
  "//": "Tight permission overlay for PR-flow CODE workers, applied at spawn: claude --worktree <slug> --bg --permission-mode acceptEdits --settings <this file>. Deny beats allow. Guard files and merge/main-push are denied; feature-branch push + PR creation are allowed. Growth rule: a stalled worker becomes a board item; the coordinator proposes the exact pattern + reason; the user applies it.",
  "permissions": {
    "deny": [
      "Edit(**/.claude/settings*.json)",
      "Write(**/.claude/settings*.json)",
      "Edit(**/.claude/hooks/**)",
      "Write(**/.claude/hooks/**)",
      "Edit(**/.githooks/**)",
      "Write(**/.githooks/**)",
      "Edit(**/.gitignore)",
      "Write(**/.gitignore)",
      "Edit(**/worker-settings*.json)",
      "Write(**/worker-settings*.json)",
      "Bash(git config*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push origin main*)",
      "Bash(git push * main*)",
      "Bash(git push *HEAD:main*)",
      "Bash(gh pr merge*)",
      "Bash(gh workflow*)",
      "Bash(gh repo edit*)",
      "Bash(gh api --method*)",
      "Bash(gh api -X*)",
      "Bash(git branch -D*)",
      "Bash(python -c*)",
      "Bash(node -e*)"
    ],
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git fetch*)",
      "Bash(git pull*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git checkout*)",
      "Bash(git switch*)",
      "Bash(git branch --show-current*)",
      "Bash(git branch -a*)",
      "Bash(git rev-parse*)",
      "Bash(git worktree list*)",
      "Bash(git cherry-pick*)",
      "Bash(git push origin feat/*)",
      "Bash(git push origin fix/*)",
      "Bash(git push origin chore/*)",
      "Bash(git push origin docs/*)",
      "Bash(git push origin refactor/*)",
      "Bash(git push origin test/*)",
      "Bash(gh pr create*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(pytest*)",
      "Bash(python -m pytest*)",
      "Bash(npm test*)"
    ]
  }
}
